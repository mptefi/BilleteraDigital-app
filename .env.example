# Proyecto ficticio de Firebase Emulator Suite.
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-altoque
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-altoque.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-altoque.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Emulador Android. Para un teléfono Android por USB, usa adb reverse y 127.0.0.1.
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://10.0.2.2:9099
EXPO_PUBLIC_ALTOQUE_API_URL=http://10.0.2.2:5001/demo-altoque/us-central1/api

# Opcionales para un development build Android con EAS/FCM.
EXPO_PUBLIC_EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=
